{
  "compilerOptions": {
    "target": "ES2022",
     "module": "Node16",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true
  },
  "include": ["src/**/*", "tests/**/*", "orchestrator/runner/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
